{
  "mappings": [
    {
      "name": "discord-token-exchange",
      "request": {
        "method": "POST",
        "urlPath": "/oauth2/token"
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{{formData request.body 'form' urlDecode=true}}{\"access_token\":\"{{#if form.code}}{{form.code}}{{else}}{{form.refresh_token}}{{/if}}\",\"refresh_token\":\"{{#if form.code}}{{form.code}}{{else}}{{form.refresh_token}}{{/if}}\",\"expires_in\":604800,\"scope\":\"identify email\",\"token_type\":\"Bearer\"}",
        "transformers": ["response-template"]
      }
    },
    {
      "name": "discord-users-me",
      "priority": 1,
      "request": {
        "method": "GET",
        "urlPath": "/users/@me"
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{{regexExtract request.headers.Authorization 'Bearer (.+)' 'auth'}}{\"id\":\"{{auth.0}}\",\"username\":\"{{auth.0}}\",\"global_name\":\"{{auth.0}}\",\"email\":\"{{auth.0}}@dev.local\"}",
        "transformers": ["response-template"]
      }
    },
    {
      "name": "discord-users-by-id",
      "priority": 5,
      "request": {
        "method": "GET",
        "urlPathPattern": "/users/[^/]+",
        "headers": {
          "Authorization": {
            "matches": "Bot .+"
          }
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\"id\":\"560204799925288962\",\"avatar\":\"d2a62c3ce9abbd98fe29469d540fda51\",\"username\":\"{{request.pathSegments.[1]}}\",\"email\":\"{{request.pathSegments.[1]}}@dev.local\"}",
        "transformers": ["response-template"]
      }
    },
    {
      "name": "discord-token-revoke",
      "request": {
        "method": "POST",
        "urlPath": "/oauth2/token/revoke"
      },
      "response": {
        "status": 200
      }
    },
    {
      "name": "discord-unmatched",
      "priority": 10,
      "request": {
        "urlPattern": ".*"
      },
      "response": {
        "status": 404,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\"error\":{\"message\":\"No stub matched {{request.method}} {{request.url}}\",\"type\":\"stub_not_matched\",\"code\":\"404\"}}",
        "transformers": ["response-template"]
      }
    }
  ]
}
